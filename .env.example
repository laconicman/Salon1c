# Copy to `.env` (git-ignored) at the package root — the live and mock suites read it
# when the variables aren't already in the process environment. Process env wins.

# --- Apiary mock suite (network only, no credentials) ---------------------------
# Arms MockServerTests: the generated client against the vendor's own Apiary mock.
SALON1C_MOCK_TESTS=1
# Override for a private Apiary project; the `/api` prefix must stay.
# SALON1C_MOCK_URL=http://private-anon-5309c9fb20-salon1c.apiary-mock.com/api

# --- Live API suite (needs a network where cloud.salon1c.ru answers) ------------
# Required:
SALON1C_API_KEY=00000000-0000-0000-0000-000000000000
SALON1C_SALON_ID=00000000-0000-0000-0000-000000000000
# Optional — arms client-scoped (usertoken) operations:
# SALON1C_USER_TOKEN=

# --- Mutating suite (on top of the above, off unless explicitly armed) -----------
# SALON1C_ALLOW_MUTATING_LIVE_TESTS=1
# Digits only — createClient's phone is the documented numeric variant:
# SALON1C_TEST_PHONE=79001001010
