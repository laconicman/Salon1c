                  "title": "Кондиционеры",
                  "included_groups": null
                },
                {
                  "id": "f668be86-144a-11eb-8071-04d4c44bd374",
                  "title": "Крема",
                  "included_groups": [
                    {
                      "id": "31f2b19d-143e-11eb-8071-04d4c44bd374",
                      "title": "Крема для рук",
                      "included_groups": null
                    },
                    {
                      "id": "3ee62603-143e-11eb-8071-04d4c44bd374",
                      "title": "Крема для тела",
                      "included_groups": null
                    }
                  ]
                }
              ],
              "errors": {
                "code": 0,
                "message": ""
              }
            }


## Получить контактную информацию магазина {contact_information} [/hs/api/v1/contact_information/{salon_id}]

Метод возвращает структуру с контактной информацией магазина.

Структура возврата содержит следующие поля:

| Поле                      |  | Тип        | Описание                                                                                    |
| ------------------------- |--| ---------- | ------------------------------------------------------------------------------------------- |
| id                        |  | string     | Идентификатор магазина                                                                      |
| name                      |  | string     | Наименование магазина                                                                       |
| contact_information:      |  | array      | Массив, содержащий контакную информацию                                                     |
|  | type                      | string     | Вид контактной информации                                                                   |
|  | title                     | string     | Представление контактной информации                                                         |
| work_schedule             |  | string     | Возвращает представление графика работы магазина                                            |
| pictures                  |  | array      | Массив ссылок на картинки номенклатуры                                                      |

### Получить контатную информацию [GET]

+ Request (application/json)

    + Headers

            apikey:409265d1-a0af-4ce8-88ec-7e3435024111

+ Response 200 (application/json)
            
