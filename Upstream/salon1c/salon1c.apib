FORMAT: 1A
HOST: http://cloud.salon1c.ru/api/

# API 1С:SPA-Салон, редакция 3.0 

Документация API для 1С:SPA-Салон, редакция 3.0

# Data Structures

## cart

+ purchase_id (required, string) - Идентификатор номенклатуры
+ count (optional, number) - Количество номенклатуры. Необходимо передавать в онлайн магазине
+ staff_id (optional, string) - Идентификатор сотрудника. Необходимо передавать в терминалах самообслуживания.

## Payment

+ cash (required, number) - Сумма оплаты наличными
+ card (required, number) - Сумма оплаты картой
+ deposit (required, number) - Сумма оплаты лицевым счетом

## PaymentList

+ type (required, string) - Тип оплаты ("cash" - оплата наличными, "card" - оплата картой, "deposit" - оплата с лицевого счета, "bonus" - оплата с бонусного счета)
+ amount (required, number) - Сумма оплаты
+ id (optional, string) - Идентификатор лицевого счета (необходимо передавать только при оплате с лицевого/бонусного счета)

## Record

+ datetime (required, string) - Дата в формате iso8601. Дата и время занятия
+ service_id (required, string) - Идентификатор услуги
+ staff_id (optional, string) - Идентификатор сотрудника. Если не передан, то в визит подставится любой свободный сотрудник, способный оказать услугу

## delivery

+ id (required, string) - Идентификатор номенклатуры доставки
+ price (required, number) - Стоимость услуги доставки
+ options (required, object) - Объект с данными ЯД, если идентификатор номенклатуры не относится к ЯД, то должен быть null

## client

+ phone (optional, string) - Телефон клиента. Необходим, если в заголовках не передается usertoken
+ last_name (optional, string) - Фамилия клиента. Требуется, если в заголовках не передается usertoken
+ name (optional, string) - Имя клиента. Необходимо, если в заголовках не передается usertoken
+ second_name (optional, string) - Отчество клиента. Если в заголовках не передается usertoken, то данный параметр будет добавлен создаваемому клиенту
+ birthday (optional, string) - Дата рождения в формате: "31.12.1990". Если в заголовках не передается usertoken, то данный параметр будет добавлен создаваемому клиенту

## GiftTo

+ phone (required, string) - Телефон клиента
+ name (optional, string) - Имя клиента
+ email (optional, string) - Почта клиента

## Filter (object)
+ type: id (string, required) - Тип фильтра (`id`, `name`, `surname`, `patronymic`, `phone`, `email`)
+ value: ['47efc7f111104513a25b302e6712df59', '04d419c74d6d11efb1c4f02f7488d897'] (array[string], required) - Значение для фильтрации. Может быть как строкой, так и массивом строк

## Client (object)
+ id: 47efc7f111104513a25b302e6712df59 (string)
+ salon_id: 0d190fc81c0111efb1bff02f7488d897' (string)
+ name: Иван (string)
+ surname: Петров (string)
+ patronymic: Васильевич (string)
+ birth_date: 07.10.1987 (nullable)
+ phone: 77777777777 (string)
+ email: client21321@mail.ru (nullable)
+ sold_amount: 0 (number)
+ visits_count: 5 (number)

## Error (object)
+ code: 0 (number)
+ message: Описание ошибки (string)

## ErrorBadRequest (object)
+ code: 1001 (number) - Пример кода ошибки при неверных данных или заголовках
+ message: Неверный формат данных или отсутствует apikey (string)

## Meta (object)
+ items_count: 10 (number) - Общее количество найденных записей
+ pages_count: 2 (number) - Общее количество страниц
+ page_current: 1 (number) - Текущая страница
+ page_size: 5 (number) - Размер страницы

## ClientCreate (object)
+ name: Василий (string, optional) - Имя клиента
+ surname: Соновен (string, optional) - Фамилия клиента
+ patronymic: Васильевич (string, optional) - Отчество клиента
+ phone: 79211234567 (number, required) - Номер телефона (только цифры)
+ email: 123456789@gmail.com (string, optional) - Email клиента
+ sex: 1 (number, optional) - Пол (0 — не указан, 1 — мужчина, 2 — женщина)
+ birth_date: 2011-01-01 (string, optional) - Дата рождения в формате `YYYY-MM-DD`

## Salon (object)
+ id: 0d190fc8-1c01-11ef-b1bf-f02f7488d897 (string) - Уникальный идентификатор салона
+ title: OOO "Салон красоты" (string) - Название салона
+ work_time (array[WorkTime], required) - Расписание работы по дням недели
+ contact_information (ContactInformation) - Контактная информация салона

## WorkTime (object)
+ active: true (boolean) - Признак активности дня
+ day: 1 (number) - День недели (1 = понедельник, 7 = воскресенье)
+ start: 07:00 (string) - Время начала работы (формат `HH:mm`)
+ end: 22:00 (string) - Время окончания работы (формат `HH:mm`)

## ContactInformation (object)
+ phone: 78945612233 (string, optional) - Телефон салона
+ email: test_salon@mail.ru (string, optional) - Email салона
+ address: г.Москва (string, optional) - Адрес салона
+ website: www.website.ru (string, optional) - Сайт салона


## Records (object)
+ id: 7c802c46-a899-4da1-b87c-eb2d68254f0f (string) - Уникальный ID записи
+ salon_id: 0d190fc8-1c01-11ef-b1bf-f02f7488d897 (string) - ID салона
+ start_date: 2025-06-30T12:00:00 (string) - Дата и время начала визита (ISO 8601)
+ end_date: 2025-06-30T12:15:00 (string) - Дата и время окончания визита (ISO 8601)
+ create_date: 2025-06-30T09:49:06 (string) - Дата создания записи (ISO 8601)
+ client (ClientInfo, required) - Данные клиента
+ staffs (array[StaffInfo], required) - Данные сотрудника (врача)
+ services (array[Service], required) - Услуги, оказанные в рамках приёма
+ comment: Комментарий (string, optional) - Комментарий к записи
+ created_user (UserInfo, required) - Пользователь, создавший запись
+ status: confirmed (string) - Статус записи (`confirmed`, `not_confirmed`, `waiting`, `started`, `not_happen`, `ended`, `canceled`)

## ClientInfo (object)
+ id: 401b3cea-4d34-4234-b1c0-f5f96551c984 (string)
+ name: Савелий (string)
+ surname: Соновен (string)
+ patronymic: Васильевич (string)
+ display_name: Соновен Савелий Васильевич (string)
