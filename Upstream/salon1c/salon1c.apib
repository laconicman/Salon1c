            "upcoming_dates": [
                "2019-10-29T00:00:00",
                "2019-10-30T00:00:00",
                "2019-10-31T00:00:00"
            ],
            "ratings": [
            {
            "rating_parameter": {
                "id": "50a4f2a5-cdc4-11e7-893b-2c4d546557dd",
                "title": "Оценка"
            },
            "rating": 4,
            "votes_count": 3
            },
            {
            "rating_parameter": {
                "id": "b1f48dc2-cdc4-11e7-893b-2c4d546557dd",
